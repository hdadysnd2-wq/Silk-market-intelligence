# مفاتيح منصة سِلك — Silk platform keys.
# انسخ هذا الملف إلى .env واملأ القيم.  Copy this file to .env and fill values.
# (.env متجاهَل في git — لا يُرفع.  .env is gitignored — never committed.)

# ── مصادر البيانات · DATA SOURCES ─────────────────────────────────────────────

# UN Comtrade: اختياري. بدونه يعمل وضع المعاينة (محدود). بمفتاح مجاني يرتفع الحد
# إلى ~500 طلب/يوم. سجّل في: https://comtradedeveloper.un.org
COMTRADE_API_KEY=

# World Bank: لا يحتاج مفتاحًا إطلاقًا (مفتوح).  No key needed (open API).

# ── حراسة الموجة ٠ · WAVE-0 GUARDS (اضبطها كلها في الإنتاج) ───────────────────

# مصادقة /analyze: عند ضبطه يتطلب كل طلب ترويسة X-API-Key مطابقة وإلا 401.
# غير مضبوط = وضع تطوير مفتوح. Auth for POST /analyze (401 without header).
SILK_API_KEY=

# WP-7: سلطة تجاوز بوابة الجودة (?override=1 على تصدير العميل) — ترويسة
# X-Owner-Key يجب أن تطابق هذه القيمة؛ مفتاح API العادي وحده لا يكفي (403).
# غير مضبوط = لا تجاوز ممكن إطلاقاً. Owner-only quality-gate override key.
SILK_OWNER_KEY=

# سقف الطبقات المدفوعة اليومي: عدد تفعيلات (localprice/volza/explee/ai) المسموح
# يوميًا؛ التجاوز = 429. غير مضبوط = لا سقف (تطوير). Daily paid-layer cap (429).
# ملاحظة أمنية (M-2): عند تعذّر قراءة العدّاد (قرص/قفل/تلف) تُرفض الطبقات
# المدفوعة (fail-closed) — الرفض أأمن من تجاوز صامت للسقف.
# دلالة عدم الاسترداد (البند #10، تدقيق v2): الحجز يقع **قبل** النداء ولا يُردّ
# إن فشل النداء أو عاد بلا نتيجة (تعذّر قراءة صورة الاستقبال، انقطاع مزوّد) —
# قرارٌ مقصود (fail-closed: لا نُنقِص محاسبةً لنداءٍ جرت محاولته). فبانقطاعٍ
# متكرّر قد يُستنفَد العدّاد بلا نتائج ناجحة؛ هذا السلوك المتوقَّع لا خلل.
# No-refund semantics: a unit is reserved before the call and NOT refunded on
# failure/empty result (fail-closed) — a provider outage can exhaust the cap
# with zero successful reads; this is intended, not a bug.
SILK_PAID_DAILY_CAP=

# حدّ الإنفاق الدولاري اليومي (H6، تدقيق 2026-07-15): SILK_PAID_DAILY_CAP يحدّ
# *عدد* التفعيلات؛ هذا يحدّ *الدولارات* الفعلية المُقدَّرة (تشغيلة /research قد
# تكلّف ~$7 وهي تفعيلة واحدة). حجز ذرّي (BEGIN IMMEDIATE): يُحجَز التقدير قبل
# بدء /research ويُرفض البدء بـ429 حين (المُنفَق + المتوقَّع) > السقف، فلا تمرّ
# تشغيلتان متزامنتان قرب الحدّ معاً. الإنفاق الفعلي (رموز كل نداءات كلود بما فيها
# محاولات تصعيد الكاتب ودورات المراجع) يُصالِح الحجز بعد التشغيلة. غير مضبوط =>
# لا حدّ دولاري. عدّاد التفعيلات الذرّي يبقى الحارس المالي fail-closed المستقل.
SILK_PAID_DAILY_USD_CAP=
# التكلفة المتوقَّعة لتشغيلة /research (للبوابة المسبقة أعلاه) — الافتراضي 3.0$.
SILK_RESEARCH_EXPECTED_USD=

# ── ذكاء ما قبل التشغيل (Wave 1) · PRE-RUN INTELLIGENCE ───────────────────────
# كلّها أعلامٌ افتراضها «السلوك كاليوم» (مُطفأة) — فعّلها في الإنتاج بعد المراجعة.
# All default to today's behavior (off); enable in production after review.
#
# مُصنِّف HS العام: حين يفشل المُحلِّل الحتمي أو تضعف ثقته، نداءُ كلود واحدٌ
# مقيس (count + dollar، ضمن السقف اليومي المشترك) يقترح HS6 من معرفته الكاملة
# بنظام HS — مصادَقٌ ببوابة تحقّق حتمية، اقتراحٌ يؤكّده المستخدم، لا اختلاق.
# يحتاج ANTHROPIC_API_KEY. **فشل-آمن: مفعّل افتراضياً** (اللائحة ٤٢) — اتركه
# فارغاً للسلوك الافتراضي؛ اضبطه على 0 فقط لتعطيله عمداً (يعود عندها لسقف
# جدول البحث الجزئي القديم). HS-classifier (metered, grounded, ON by default).
SILK_HS_CLASSIFIER=
# التكلفة الدولارية المتوقَّعة لنداء التصنيف الواحد (للمصالحة) — الافتراضي 0.02$.
SILK_HS_CLASSIFY_EXPECTED_USD=
# عتبة ثقة المُحلِّل الحتمي التي دونها نستدعي كلود — الافتراضي 0.7 (كـresolve_all).
SILK_HS_MIN_CONFIDENCE=
# عدد مرشّحي المرجع للإرساء/المنتقي اليدوي — الافتراضي 8.
SILK_HS_CLASSIFIER_CANDIDATES=
#
# حسمُ الرمز بالسمة الرقمية (اللائحة ٦٥ — «قِسِ الرقمَ قبل أن تسأل عنه»):
# حين تتمايز بنودُ الترويسة بعتبةٍ رقمية (نسبة دهن/سعة/وزن/بريكس)، يُقاس
# الرقمُ قبل عرض أيّ حوار: سماتُ بطاقة العبوة من نداء الرؤية القائم (صفر
# تكلفة إضافية) ثم استعلامُ بحثٍ واحد (SEARCH_API_KEY) برابطٍ قابلٍ للاستشهاد.
# بلا رقمٍ يقع في نطاقٍ **وحيد** لا يُحسَم رمزٌ أبداً — يُعرَض الحوار (لا
# اختلاق). **مفعّل افتراضياً**؛ اضبطه على 0 للعودة إلى «اسأل المستخدمَ دائماً».
# Numeric-attribute HS auto-resolution (image label → web → dialog). ON.
SILK_HS_ATTRIBUTE_RESOLVE=
# نافذةُ الجوار (محارف) بين اسم البُعد والرقم في نصّ نتيجة البحث — الافتراضي 60.
SILK_HS_ATTR_PROXIMITY=
# عدد نتائج البحث المفحوصة في استعلام السمة الواحد — الافتراضي 5.
SILK_HS_ATTR_WEB_RESULTS=
# سقفُ السمات الرقمية المقروءة من بطاقة العبوة في نداء الرؤية — الافتراضي 12.
SILK_INTAKE_MAX_ATTRIBUTES=
#
# البوّابة الصلبة: =1 يرفض /research بـ422 ما دام رمز HS فارغًا (قبل أيّ حجز/
# إنفاق) — يُغلق حادثة الفيتوتشيني (دراسةٌ مدفوعةٌ برمز مجهول). Hard hs6 gate.
SILK_REQUIRE_HS6=
#
# استشارة بلد المنشأ: =1 يُحذّر (422 حتى موافقة صريحة producer_ack) حين السوق
# المستهدفة من أكبر مصدّري هذا الرمز عالميًا (بيانات كومتريد، صفر نداء مدفوع).
# Producer-country advisory (top-exporter warning; consent required).
SILK_PRODUCER_ADVISORY=
# عتبة «من أكبر المصدّرين» (أكبر N) — الافتراضي 5. Top-N exporters threshold.
SILK_PRODUCER_ADVISORY_TOPN=

# البند أ٢ — معقولية بلد المورّد: =1 يُحذّر (422 حتى a2_ack) حين لا يظهر كبار
# موردي السوق لهذا الرمز بين أكبر مصدّري الرمز عالميًا (تفكّكٌ شبه تامّ = الرمز
# قد يصف عائلةً مختلفة). كومتريد فقط، صفر نداء مدفوع. مطفأ افتراضيًا.
# A2 supplier-country plausibility advisory (consent required); off by default.
SILK_A2_PLAUSIBILITY=
# أقصى تداخلٍ (0..1) يُطلق التحذير — الافتراضي 0.0 (تفكّكٌ تامّ فقط).
SILK_A2_MAX_OVERLAP=
# الحدّ الأدنى لعدد الموردين/المصدّرين لكلا الطرفين قبل الحكم — الافتراضي 3.
SILK_A2_MIN_ENTRIES=
# أعلى M مورّدٍ للسوق يُفحَصون — الافتراضي 5. Top-M market suppliers checked.
SILK_A2_SUPPLIERS_TOPM=

# حزمة الإغلاق — البند ٣: /diagnostics يُطلق نداءات مدفوعة حيّة (Serper/Maps/
# Claude) بمفاتيح الخادم، فيحجز وحدة واحدة من SILK_PAID_DAILY_CAP قبل الفحص حين
# السقف مضبوط (بلا سقف: لا حجز، سلوك افتراضي). اضبط =1 لإعفاء التشخيص من السقف
# (تشخيص متكرر أثناء تصحيح النشر بلا استهلاك الرصيد). غير مضبوط => لا إعفاء.
SILK_DIAG_EXEMPT=

# حزمة الإغلاق — البند ٢: عتبة نبضة حاصد التشغيلات اليتيمة بالدقائق (الافتراضي
# ٣٠، أطول من أطول تشغيلة /research مشروعة). صفّ 'running' لم يُلمَس (updated_at)
# منذ هذه المدة = عمليته ماتت (إعادة نشر/SIGKILL) فيُوسَم 'failed' ويُصالَح حجزه
# الدولاري إلى الفعلي-حتى-الآن — عند الإقلاع ودورياً.
SILK_ORPHAN_STALE_MINUTES=

# تحديد المعدّل (M-1): أقصى عدد طلبات لكل هوية (X-API-Key أو IP) خلال النافذة؛
# التجاوز = 429. الافتراضي 120 طلباً/60 ثانية؛ 0 يعطّل الحدّ. تحديد بالذاكرة
# (أداة داخلية، بلا Redis). Simple in-memory rate limit (per key/IP).
# SILK_RATE_LIMIT=120
# SILK_RATE_WINDOW=60

# ملف عدّاد الاستهلاك (اختياري) — مستقل عن silk.db. Usage-counter DB path.
# SILK_USAGE_DB=data/usage.db

# القرص الدائم (Railway volume): متغير واحد يوجّه **كل** المخازن للقرص —
# قاعدة التحليلات silk.db + مخزن الحقائق silk_store.db + عدّاد usage.db +
# ذاكرة الطلبات cache/ — فتنجو كلها من إعادة النشر ولا يُدفع ثمن الجلب مرتين.
# One var points EVERY store at the persistent volume (survives redeploys).
# المتغيرات الصريحة أدناه تفوز عليه فرادى — explicit per-store vars win over it.
# SILK_DATA_DIR=/data

# مصيدة إقلاع (LESSONS.md البند ٤): اضبطها =1 على الإنتاج مع SILK_DATA_DIR —
# فترفض الخدمة الإقلاع بصوت عالٍ إن غاب توجيه تخزين دائم (SILK_DATA_DIR/SILK_DB)
# بدل الكتابة الصامتة على قرص فانٍ يُمحى عند إعادة النشر فتُفقَد التحليلات.
# مطفأة افتراضياً (وضع تطوير مفتوح). Fail-fast if no persistent store is routed.
# تقوية (بلاغ مالك حيّ): لا تكتفي بأن المتغيّر مضبوط — تتحقّق أن المسار وحدة
# تخزين مركَّبة فعلًا (os.path.ismount) وقابل للكتابة، وإلا ترفض الإقلاع (كان
# SILK_DATA_DIR=/data مضبوطًا بلا Volume مركَّب فتُمحى الدراسات المدفوعة بصمت).
# SILK_REQUIRE_PERSISTENT_DATA_DIR=1

# مخرج صريح لمضيفٍ قرصه الجذري دائم أصلًا (لا وحدة تخزين منفصلة): =1 يتخطّى فحص
# «مركَّب فعلًا» أعلاه مع إبقاء فحص القابلية للكتابة. قرار مشغّل صريح لا صمت.
# Escape hatch when the host root disk is itself persistent (no separate mount).
# SILK_ALLOW_NONMOUNT_PERSIST=1

# مسار قاعدة التحليلات (اختياري) — وجّهه لقرص دائم في الإنتاج (Railway volume
# على /data مثلًا؛ لا تركّب القرص فوق data/ لأنه يحوي ملفات CSV مرجعية).
# Analyses DB path override — point at a persistent disk in production
# (e.g. a Railway volume at /data; never mount over data/, it holds seed CSVs).
# SILK_DB=/data/silk.db

# مخزن الحقائق الموحّد (تدفقات تجارية/مؤشرات) — نفس القرص. Fact-store DB path.
# SILK_STORE_DB=/data/silk_store.db

# مجلد ذاكرة طلبات GET على القرص (silk_cache) — نفس القرص. Request-cache dir.
# SILK_CACHE_DIR=/data/cache

# ── التحديث الدوري · SCHEDULED REFRESH ────────────────────────────────────────
# ساعات بين تشغيلات تحديث المخزن (silk_collectors.refresh: مؤشرات البنك الدولي
# + تسخين مسبق لتدفقات Comtrade — رموز HS الأخيرة × أسواق الأولوية، بميزانية
# صلبة وbackoff). غير مضبوط/0 = معطّل. يعمل خيطاً داخل خدمة الويب (قرص Railway
# يُركَّب على خدمة واحدة — لا خدمة cron منفصلة).
# Hours between refresh runs; unset/0 = off. Runs in-process (volume is
# single-service on Railway).
# SILK_REFRESH_HOURS=24

# تأخير أول تشغيلة بعد الإقلاع بالثواني (افتراضي 120). Initial delay seconds.
# SILK_REFRESH_INITIAL_S=120

# احتياطي ميزانية Comtrade يُترك للطلبات الحية أثناء التسخين (افتراضي 150).
# Comtrade-budget reserve kept for live traffic during pre-warm.
# SILK_REFRESH_BUDGET_RESERVE=150

# أسواق الأولوية للتسخين المسبق (ISO3 بفواصل؛ الافتراضي أول 12 من قائمة المنصّة).
# Priority markets for pre-warming (comma ISO3; default: platform top 12).
# SILK_PRIORITY_MARKETS=ARE,KWT,QAT,OMN,BHR,EGY,JOR

# ── سياسة الحداثة · FRESHNESS / TTL POLICY ────────────────────────────────────
# نافذة الحداثة بالأيام لكل نوع: داخلها تُخدم القيمة من المخزن فوراً (مجاناً)؛
# خارجها تُخدم فوراً معلَّمة «stale» ويُطلَق تحديث بالخلفية (stale-while-
# revalidate). Freshness windows per data type (serve fast, refresh behind).
# SILK_FRESH_TRADE_DAYS=90
# SILK_FRESH_INDICATOR_DAYS=30
# SILK_FRESH_PRICE_DAYS=7

# تعطيل تحديث الخلفية عند العتاقة (للتشخيص فقط) — SWR kill switch.
# SILK_SWR=0

# مباعدة نداءات HTTP لكل مضيف (مللي ثانية) — النافذة العامة، وكومتريد له
# نافذة أوسع خاصة (بلاغ حي: 429 متكرر — حد كومتريد ~نداء/ثانية، والبعثات
# الاثنتا عشرة المتوازية تتشاركه). Per-host min gap; Comtrade gets its own.
# SILK_HTTP_MIN_GAP_MS=250
# SILK_COMTRADE_MIN_GAP_MS=1100
# SILK_HTTP_RETRIES=3

# مهلة الاتصال لكل مصدر (ثانية) — WS4: البنك الدولي أبطأ عادةً فيأخذ نافذةً
# أوسع من كومتريد؛ غير المعروف يبقى على القديم (30). Per-source HTTP timeout.
# SILK_WB_TIMEOUT_S=45
# SILK_COMTRADE_TIMEOUT_S=30
# SILK_HTTP_TIMEOUT_S=30

# قاطع الدائرة لكل مضيف (WS4) — بعد N فشلٍ 429/5xx متتالٍ (THRESHOLD)، نداءات
# المضيف اللاحقة تفشل بسرعة (بلا حلقة إعادة تعلّق الـfan-out) طوال فترة التهدئة
# (COOLDOWN_S)، ثم تُسمح محاولةٌ استكشافية واحدة (نصف-مفتوح): **فترة التهدئة نفسها
# هي فاصل المحاولة الاستكشافية** — probe مسموحٌ مرّةً كلّ نافذة تهدئة. النجاح
# يغلق الدائرة فوراً. تحذير: عتبةٌ منخفضةٌ جداً عبر ~١٥٠ نداء fan-out تحوّل 429
# العابر إلى فجواتٍ معلنة — أبقِ العتبة كافيةً (الافتراض 5) والتهدئة قصيرةً (60ث).
# Consecutive-failure breaker; cooldown doubles as the half-open probe interval.
# SILK_CIRCUIT_THRESHOLD=5
# SILK_CIRCUIT_COOLDOWN_S=60

# تعطيل FAOSTAT صراحة (فجوة معلنة بلا أي محاولة جلب) — بلاغ حي: 401 متكرر؛
# بلا هذا العلم، أول 401/403 يفعّل قاطع دارة تلقائياً لبقية عمر العملية.
# Kill switch; without it, the first 401/403 auto-disables for the process.
# SILK_DISABLE_FAOSTAT=1

# مهلات نداءات كلود (ثوانٍ) — القياسية للبعثات، والموسّعة للمحلل الشامل
# وكاتب التقرير (مدخلاهما نتائج البعثات الاثنتي عشرة كاملة).
# SILK_AI_TIMEOUT_S=60
# SILK_AI_LONG_TIMEOUT_S=300

# إعادة محاولة نداء كلود على الحالات العابرة فقط — 429 (تجاوز حصّة/معدّل) و529
# (ازدحام Anthropic). بلاغ حي (كاتب التقرير): نداء الكاتب الثقيل في ذيل التشغيلة
# كان يفشل من أول رفض عابر (بلا إعادة محاولة) فيصير report=None. كلاهما يُرفض
# قبل التوليد فكلفة الرموز صفر؛ backoff أسّي + احترام ترويسة Retry-After. غير
# العابر (400/401/مهلة/شبكة) لا يُعاد. =0 يعطّل الإعادة (سلوك ما قبل الإصلاح).
# SILK_LLM_MAX_RETRIES=2
# أساس backoff بالثواني (المحاولة n تنتظر base×2^n ما لم تُحدِّد Retry-After).
# SILK_LLM_RETRY_BASE_S=1.0

# النماذج التي تُهمَل معها معاملات المعاينة temperature/top_p/top_k (بادئات
# مفصولة بفواصل أو مسافات). الخلفية: Claude 4.7 فصاعداً أزالت الثلاثة معاً،
# فإرسال أيٍّ منها يردّ 400 ويسقط نداء التوليف/الكاتب/المراجع كاملاً (تقرير
# بلا سرد). حضور المفتاح وحده يكفي للرفض، فيُحذف ولا يُضبَط على 1.0. القرار
# لكل نموذج: silk_llm_provider._supports_sampling_params. ما زال يقبلها:
# claude-haiku-4-5-*, claude-sonnet-4-6 وما قبلها.
# ضبط المتغيّر **يحلّ محل** الافتراضية بالكامل: أضِف بادئة حين يُرقّى نموذج
# آخر (بلا نشر)، أو اضبطه فارغاً («») فلا يُستثنى نموذج. غير مضبوط =
# الافتراضية أدناه. القيمة الفعّالة والنموذج المحلول في GET /health → ai_model.
# SILK_LLM_NO_SAMPLING_PARAMS=claude-opus-4-7,claude-opus-4-8,claude-opus-5,claude-sonnet-5,claude-fable-5,claude-mythos

# CORS: أصول الواجهة المسموح لها بنداء الـ API (مفصولة بفواصل).
# الافتراضي الآن: نفس الأصل فقط (لا CORS) — الواجهة تُقدَّم من نفس الخدمة.
# للواجهة المنفصلة (Netlify) ضع دومينها؛ "*" يتطلب ضبطًا صريحًا ولا يُنصح به.
# CORS_ORIGINS=https://sage-pavlova-c221b1.netlify.app

# Google Trends (silk_trends_agent): لا مفتاح — يحتاج فقط: pip install pytrends
# Stage 2A: Trends وWITS وFAOSTAT ومرجع L1 مفعّلة دائماً بسياسة الخادم — لا تُدار
# بأعلام الواجهة. Always-on by server policy; UI flags no longer gate sources.

# Google Maps (silk_maps_agent): مجاني بحصة — مصانع/موزّعون/منافسون بالاسم وتقييماتهم.
# Free tier with quota. Real businesses + ratings by name (Places Text Search).
GOOGLE_MAPS_API_KEY=

# مكشطة خرائط قوقل (C1، silk_gmaps): عنوان **خدمة Railway ثانية** تشغّل
# gosom/google-maps-scraper (وضع خادم الويب + REST API) على الشبكة الخاصة —
# ليست حاوية بايثون هذه. اتركه فارغاً = تعطيل نظيف (لا كشط، لا أثر على /health
# أو المهام). راجع docs/DEPLOY_SCRAPER.md لخطوات النشر الدقيقة. مثال القيمة:
# http://gmaps-scraper.railway.internal:8080  (اسم مضيف داخلي خاص، لا عام).
# Second Railway service URL (private networking only, NEVER public). Empty =
# cleanly disabled. C2–C5 integration opens only after the owner confirms live.
SILK_GMAPS_SCRAPER_URL=

# Web Search (silk_websearch_agent): مجاني بحصة — Serper.dev افتراضيًا (SEARCH_PROVIDER).
# Free tier. Default provider Serper.dev (Google Search). Consumer/market signals.
# يُقبل أيضًا تحت الاسم SERPER_API_KEY (مرادف — SEARCH_API_KEY أعلى سلطة).
# Also accepted as SERPER_API_KEY (alias; SEARCH_API_KEY wins if both set).
SEARCH_API_KEY=

# WTO Tariff & Trade Data (silk_wto_tariff): مفتاح اشتراك **مجاني** بالتسجيل في
# apiportal.wto.org — يفعّل مصدر التعريفة الأساسي في سلسلة تراجع التعريفة
# (WTO TTD → WITS → فجوة معلنة)، ويسدّ فجوة التعريفة الثنائية المزمنة في WITS
# للأسواق الأوروبية. غائب => WTO يتدهور فورًا لفجوة معلنة صفريّة النداء، فيتولّى
# WITS كالسابق. يُقبل أيضًا تحت الاسم WTO_API_KEY. (IMF WEO مجاني بلا مفتاح.)
# Free WTO Timeseries subscription key; empty = WTO degrades cleanly, WITS serves.
WTO_TTD_API_KEY=

# أسعار السوق المحلي (silk_localprice_agent): مدفوع (SerpApi Google Shopping) —
# أسعار رفّ فعلية + مقارنة سعرك. طبقة /deepen فقط. PAID retail prices (deepen-only).
LOCALPRICE_API_KEY=

# Volza (silk_volza_agent): مدفوع — مستوردون بالاسم من بيانات بوالص الشحن.
# PAID subscription. Named importers/exporters from bills of lading.
VOLZA_API_KEY=

# explee (silk_explee_agent): مدفوع — مشترون وجهات اتصال B2B (امتثال GDPR/PDPL).
# PAID account (first ~333 lookups free). B2B buyers/contacts — legitimate outreach only.
EXPLEE_API_KEY=

# ── الذكاء الاصطناعي · OPTIONAL AI LAYER ──────────────────────────────────────
# الطبقة 3 (silk_ai_judge.py): كلود حَكَمًا ومُعِدّ تقرير فوق حقائق الوكلاء
# الموسومة فقط. P5: يعمل تلقائيًا على /analyze متى كان هذا المفتاح مضبوطًا
# **مع SILK_API_KEY** (بدون SILK_API_KEY يُحجب كل نداء كلود — حارس H2)؛
# بدونه تتدهور بأمان إلى لجنة التحكيم الحتمية. يُحتسب ضمن SILK_PAID_DAILY_CAP.
# Layer 3: Claude judge + report. P5: auto-on for /analyze when this key AND
# SILK_API_KEY are both set (H2 guard blocks it otherwise). Counted in the cap.
ANTHROPIC_API_KEY=

# ── أعلام الميزات الاختيارية · OPTIONAL FEATURE FLAGS (تدقيق v2، البند #9) ─────
# ميزتان مُطفأتان افتراضياً (السلوك بدونهما = سلوك اليوم حرفياً). فعّل بـ=1.

# تغطية العالم (Feature A): يوسّع ترتيب الأسواق لأكبر ~١٠٠ مستورد لكل رمز HS
# (فئة-١ منسّقة ٣٨ + فئة-٢ ديناميكية) من نداء كومتريد عالمي واحد — صفر نداء
# إضافي لكل دولة، صفر تلفيق (فجوات فئة-٢ معلنة). يفعّل أيضاً بوّابة «خارج
# التغطية» على /research. World-coverage two-tier ranking + out-of-coverage gate.
SILK_WORLD_MARKETS=0
# سقف الفئة-٢ (عدد أسواق التغطية الأساسية فوق الـ٣٨ المنسّقة). افتراضي ٦٢ (=١٠٠).
SILK_WORLD_TIER2_MAX=62

# استقبال المنتج من صورة (Feature B): يفعّل تبويبات الصورة/الكاميرا في الواجهة
# ونقطة POST /products/intake (نداء رؤية واحد مقيس يستخرج اسم المنتج للتأكيد
# قبل التحليل — لا اختلاق: ثقة دون العتبة => «اكتب الاسم يدوياً»). يتطلّب
# ANTHROPIC_API_KEY. Multimodal product intake (vision) — user confirms before analysis.
SILK_IMAGE_INTAKE=0
# عتبة الثقة الدنيا لقبول اسم مستخرَج من صورة (دونها => تعذّر قراءة صادق). افتراضي ٠٫٥٥.
SILK_INTAKE_MIN_CONFIDENCE=0.55

# مهلة كشط جهات اتصال المستوردين المتزامنة (POST /analyses/{id}/enrich-leads)
# بالثواني — آمنة للبروكسي افتراضياً (٢٥ث)؛ الكشط يواصل ويخزّن ذاتياً فإعادة
# الضغط تجلب ما اكتمل. Proxy-safe sync grace for lead enrichment (background self-caches).
SILK_GMAPS_ENRICH_GRACE_S=25

# البند هـ — حارس البنية الفرعية لقسم التوصيات: =1 يُضيف تحذيرات WARN غير حاجبة
# حين يخلو قسم التوصيات من خارطة ٩٠ يومًا / فرع «شرطا قلب الحكم» (للحكم المشروط).
# مطفأ افتراضيًا حتى معايرة معدّل التحذير على نثرٍ حيّ. E sub-structure guard.
SILK_E_SUBSTRUCTURE_CHECK=

# ═══════════════════════════════════════════════════════════════════════════
# منصّة سِلك متعددة المستأجرين (PR-1) · Silk multi-tenant platform (silk_platform/)
# ═══════════════════════════════════════════════════════════════════════════
# قاعدة بيانات المنصّة — مستقلّة عن data/silk.db؛ تُشتَقّ من SILK_DATA_DIR حين تُترك.
# Platform DB, separate from the market-intelligence store (derived from SILK_DATA_DIR).
SILK_PLATFORM_DB=

# سرّ توقيع الرموز وتعمية بيانات اعتماد SMTP عند التخزين — KMS/Vault في الإنتاج.
# غير مضبوط => سرّ عابر لكل عملية (تطوير فقط؛ التواقيع لا تصمد عبر إعادة التشغيل).
# Signing/field-encryption secret; unset ⇒ ephemeral per-process (dev only).
SILK_PLATFORM_SECRET=

# كلمات مرور البذر — افتراضياتها للتطوير فقط، استبدلها قبل أي نشر.
# Seed passwords — dev defaults; override before any deployment.
SILK_SEED_ADMIN_PASSWORD=
SILK_SEED_ANALYST_PASSWORD=
SILK_SEED_FACTORY_A_PASSWORD=
SILK_SEED_FACTORY_B_PASSWORD=

# كشف رمز إعادة التعيين في ردّ الـAPI — للاختبار فقط (=1). الإنتاج: غير مضبوط
# فلا يُعاد الرمز الخام أبداً (يُرسَل بالبريد في PR-5)؛ كشفه يفتح استيلاءً على
# الحساب. Test-only; unset in production (raw reset token is emailed, never returned).
SILK_PLATFORM_EXPOSE_RESET_TOKEN=

# كوكي الجلسة بعلم secure (HTTPS فقط) — اضبطه =1 في الإنتاج خلف HTTPS.
# Session cookie Secure flag; set =1 in production behind HTTPS.
SILK_PLATFORM_SECURE_COOKIES=

# إشارة إنتاج تُلزِم ضبط SILK_PLATFORM_SECRET — حارس الإقلاع يفشل بصوت عالٍ لو
# ضُبطت هذي (=1) والسرّ غائب، بدل الخدمة بسرّ عابر. (SILK_PLATFORM_SECURE_COOKIES=1
# إشارة إنتاج أيضاً.) Production signal forcing the secret; boot fails loudly if unset.
SILK_PLATFORM_REQUIRE_SECRET=

# سقف المديونية بالسنتات — أقصى ما يُسمح للرصيد أن يهبط تحت الصفر. المديونية
# تحدث من مسارين مقصودين فقط: خصم بريدٍ خرج فعلاً، وفوترة تخزين شهرية (دَينٌ
# حقيقي يجب أن يُقيَّد). ما دام الرصيد سالباً: لا إطلاق ولا إرسال حتى التمويل.
# Max overdraft (cents). While negative: launches and sends are blocked.
SILK_PLATFORM_MAX_OVERDRAFT_CENTS=

# خنق تسجيل الدخول — سقف الفشل ونافذته (ثوانٍ). الحالة في قاعدة المنصّة فهي
# مشتركة بين كل عمّال uvicorn وتصمد لإعادة النشر (لا تنفصل لكل عملية).
# Login throttle; DB-backed ⇒ shared across workers, survives restarts.
SILK_PLATFORM_LOGIN_MAX_FAILURES=
SILK_PLATFORM_LOGIN_WINDOW_S=

# عامل عمل bcrypt — **للاختبارات فقط**. الإنتاج ١٢ (المواصفة §11): غياب المتغيّر
# ⇒ ١٢، وقيمة تالفة/خارج المدى ⇒ ١٢، وحارس الإقلاع **يرفض** أقلّ من ١٢ مع أي
# إشارة إنتاج. قياس: تجزئة بعامل ١٢ ≈ ٢٧٧ms، فالحزمة تخفّضه إلى ٤ (١٣٣ث ⇒ ٣١ث).
# Test-only knob; production is 12 and cannot be weakened (default+clamp+boot guard).
SILK_PLATFORM_BCRYPT_ROUNDS=
# نظير scrypt للمسار الاحتياطي (قوّة للعدد ٢؛ غير ذلك يُتجاهَل). Default 16384.
SILK_PLATFORM_SCRYPT_N=

# ── مجدول مهام المنصّة (PR-2) · platform job scheduler ───────────────────────
# خيط داخل العملية لا خدمة cron منفصلة: وحدة تخزين Railway تُركَّب على خدمة واحدة
# فقط، فمهمّة في خدمة أخرى لن ترى قاعدة المنصّة أصلاً (نفس سبب silk_collectors).
# `1` يشغّله؛ **أي قيمة أخرى أو الغياب ⇒ لا خيط إطلاقاً** — كي لا تصفّر تشغيلةُ
# اختبار أو تطوير حصّةً ولا تكتب فاتورة تخزين في قاعدة أحد.
# المواعيد (UTC): تصفير الحصص أوّل الشهر 00:00 · فوترة التخزين أوّل الشهر 01:00 ·
# تنظيف الجلسات يومياً 02:00. المهام خاملة التكرار وتلحق ما فاتها بعد توقّف.
# Opt-in in-process scheduler; unset means no thread at all.
SILK_PLATFORM_SCHEDULER=
# فترة استطلاع الخيط بالثواني (الافتراضي ٣٠٠، وأدناها ١ كي لا تصير حلقةً بلا نوم).
SILK_PLATFORM_SCHEDULER_POLL_S=

# ── تأسيس حسابات المنصّة · platform account bootstrap ────────────────────────
# **بلاغ حيّ («ما يعمل»):** `init_db()` يُنشئ الجداول ولا شيء يبذر عند الإقلاع،
# فالإنتاج كان يُقلِع بجداولَ سليمة و**صفر مستخدمين** — فكل دخول يُرفَض بـ
# «invalid credentials» لا تُميَّز عن كلمة مرور خاطئة، فيستحيل التشخيص عن بُعد.
#
# اضبط كلمة مرور الأدمِن ⇒ يبذر الإقلاع الحسابات **مرّة واحدة** (خامل التكرار،
# لا يُعيد ضبط كلمة قائمة). لا تضبطها ⇒ **لا بذر إطلاقاً** + سطر سجلّ يشرح
# السبب وما يلزم. لا كلمة مرور مولَّدة عشوائياً تضيع، ولا كلمة تُطبَع في سجلّ.
# Opt-in: set the admin password to have boot create the accounts once.
#
# ⚠️ **السياسة مُلزِمة، والمخالفة تُسقِط البذر بكامله** (بلاغ حيّ ثانٍ: ضُبطت
# البوّابة وظلّ الدخول يُرفَض بـ«invalid credentials»). كل كلمة تُضبَط هنا يجب
# أن تحقّق **الأربعة**: ٨ أحرف على الأقل + حرف صغير + حرف كبير + رقم.
#   ✅ Silk2026admin      ❌ silk2026 (بلا كبير)   ❌ SILK2026 (بلا صغير)
#                          ❌ Silkadmin (بلا رقم)  ❌ Silk123 (٧ أحرف)
# وانتبه: `seed()` يُلبِّد الكلمات الأربع **مسبقاً** قبل إدخال أيّ صفّ، فمخالفةٌ
# في **أيٍّ** منها تمنع إنشاء الأدمِن أيضاً. السببُ يظهر مباشرةً في
# GET /health ⇒ storage.platform_ready.seed_error باسم المتغيّر المخالف
# والقاعدة المخروقة (بلا قيمته أبداً — النقطة عامّة).
# Policy is enforced: 8+ chars with lower, upper and a digit. One bad value
# blocks the whole seed; /health names the offending VARIABLE, never its value.
SILK_SEED_ADMIN_PASSWORD=
# اضبطها أيضاً لتدخل مباشرةً كحساب مصنع (owner@factory-a.local) وترى اللوحة.
# بلا ضبطها تُولَّد كلمة عشوائية غير قابلة للاستعادة — والأدمِن يستطيع إصدار
# إعادة تعيين لها عبر POST /platform/admin/users/{id}/reset.
SILK_SEED_FACTORY_A_PASSWORD=
SILK_SEED_ANALYST_PASSWORD=
SILK_SEED_FACTORY_B_PASSWORD=
#
# البُرد التي يُنشئها البذر: admin@silk.local · analyst@silk.local ·
# owner@factory-a.local · owner@factory-b.local
# والتحقّق بعد النشر: GET /health ⇒ storage.platform_ready
#   {"seeded": true, "users": 4, "accounts": 3, "seed_gate_set": true,
#    "seed_error": null}
# وقراءةُ الحالات الثلاث بلا تخمين:
#   seed_gate_set: false                  ⇒ المتغيّر غير مضبوط أصلاً.
#   seed_gate_set: true + seed_error: "…" ⇒ المتغيّر المسمّى فيه يخالف السياسة.
#   seeded: true                          ⇒ الحسابات جاهزة، ادخل.
# والشاشة على /platform.html — أمّا /platform فبادئةُ API تُحوِّل إليها.


# ── طابور البريد: حاصد الصفوف العالقة (PR-5) · stuck-row reaper thresholds ───
# كل نبضة مجدول (أعلاه) تحاصد صفوف 'sending' العالقة قبل معالجة الطابور. صفٌّ
# أقدم من هذا العمر (ثوانٍ) يُعاد queued (بنفس Message-ID الحتمي — idempotency
# التسليم)، إلا إن استنفد المحاولات فيُوسَم failed بدل إعادة محاولةٍ أبدية.
SILK_PLATFORM_EMAIL_STUCK_SECONDS=
SILK_PLATFORM_EMAIL_MAX_ATTEMPTS=

# ── الأصل العام للمنصّة (PR-5) · public origin for absolute links ────────────
# يُستعمَل لبناء رابط إلغاء الاشتراك الموقَّع ورابط بريد إعادة تعيين كلمة
# المرور. الافتراض http://localhost:8000 للتطوير المحلي فقط — اضبطه في
# الإنتاج (مثلاً https://app.example.com) وإلا حملت الروابط المُرسَلة أصلاً محلياً.
SILK_PLATFORM_BASE_URL=

# ── SMTP التشغيلي: بريد إعادة تعيين كلمة المرور (PR-5) · operator transactional SMTP
# منفصل عمداً عن smtp_configs المستأجَرة المشفَّرة في القاعدة: بريد إعادة
# التعيين يصدر قبل أي جلسة مُصادَقة فلا تهيئة مستأجَر تصلح مصدراً له. غياب
# المضيف أو عنوان المرسل ⇒ لا محاولة إرسال إطلاقاً (تهيئة غير مضبوطة، لا عطل).
# فشل إرسالٍ **مع** تهيئة مضبوطة يُسجَّل تدقيقاً (`password_reset_email_failed`)
# لا في الردّ — الردّ يبقى {"ok": true} دائماً كي لا يُسرَّب وجود المستخدم.
SILK_PLATFORM_OPERATOR_SMTP_HOST=
SILK_PLATFORM_OPERATOR_SMTP_PORT=
SILK_PLATFORM_OPERATOR_SMTP_USE_TLS=
SILK_PLATFORM_OPERATOR_SMTP_USERNAME=
SILK_PLATFORM_OPERATOR_SMTP_PASSWORD=
SILK_PLATFORM_OPERATOR_SMTP_FROM_EMAIL=
SILK_PLATFORM_OPERATOR_SMTP_FROM_NAME=

# ── تخزين ملفات المنصّة (PR-8) · on-disk file storage for uploaded images ────
# قرص محلي فقط (نفس سبب SQLite: خدمة واحدة، وحدة Railway واحدة). يُشتقّ من
# SILK_DATA_DIR الموحّد ما لم يُضبَط هذا صراحةً.
SILK_PLATFORM_STORAGE_DIR=
# أقصى حجم رفع مقبول بالبايتات؛ الافتراض ١٠ ميجابايت (10485760).
SILK_PLATFORM_MAX_IMAGE_BYTES=
